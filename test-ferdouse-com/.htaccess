Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteBase /test-ferdouse-com/

RewriteCond %{THE_REQUEST} \s/+test-ferdouse-com/index\.php\?page=([A-Za-z0-9/-]+) [NC]
RewriteRule ^index\.php$ /test-ferdouse-com/%1? [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+test-ferdouse-com/index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ /test-ferdouse-com/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+test-ferdouse-com/[^?\s]+\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ /test-ferdouse-com/$1 [R=301,L,NE]

RewriteRule ^$ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [F,L]

RewriteRule ^([A-Za-z0-9][A-Za-z0-9/-]*)/$ /test-ferdouse-com/$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^(.+)/?$ index.php?page=$1 [QSA,L]
